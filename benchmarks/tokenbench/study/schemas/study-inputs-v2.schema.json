{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scopesifter/scopesifter/benchmarks/tokenbench/study/schemas/study-inputs-v2.schema.json",
  "title": "Tokenbench authenticated study input manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_sha256", "slots"],
  "properties": {
    "schema_version": {"const": "tokenbench.study-inputs/v2"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/slot"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "size", "media_type"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 1, "maximum": 65536},
        "media_type": {"const": "application/vnd.tokenbench.attestation.v2+json"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_root", "code", "detail"],
      "properties": {
        "evidence_root": {"$ref": "#/$defs/root"},
        "code": {"$ref": "#/$defs/id"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "repetition", "root", "not_attempted_reason", "exclusion"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "repetition": {"type": "integer", "minimum": 0, "maximum": 999},
        "root": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
        "not_attempted_reason": {"type": "string", "maxLength": 2000},
        "exclusion": {"anyOf": [{"$ref": "#/$defs/exclusion"}, {"type": "null"}]}
      },
      "oneOf": [
        {
          "properties": {
            "root": {"type": "null"},
            "not_attempted_reason": {"minLength": 1},
            "exclusion": {"type": "null"}
          }
        },
        {
          "properties": {
            "root": {"$ref": "#/$defs/root"},
            "not_attempted_reason": {"const": ""}
          }
        }
      ]
    }
  }
}
