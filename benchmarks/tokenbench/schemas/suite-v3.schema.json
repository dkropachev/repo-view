{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yapless/scopesifter/benchmarks/tokenbench/schemas/suite-v3.schema.json",
  "title": "Tokenbench authored code suite v3",
  "description": "One common code task and harness configuration with catalog, toolchain, and trusted execution-artifact commitments. Arms, writable paths, environments, and tool registrations are intentionally absent. This document is audit data and does not authorize a writable workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "prompt_file",
    "harness_kind",
    "harness_executable",
    "harness_sha256",
    "artifact_manifest_sha256",
    "git_executable",
    "git_executable_sha256",
    "model",
    "expected_model_revision",
    "reasoning_effort",
    "permission_profile",
    "developer_instructions",
    "source_root",
    "source_revision",
    "source_base_revision",
    "source_tree_sha256",
    "code_task",
    "timeout_millis",
    "repetitions",
    "seed"
  ],
  "properties": {
    "schema_version": {
      "const": "tokenbench.suite/v3"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "prompt_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "harness_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "harness_executable": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^/"
    },
    "harness_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "git_executable": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^/"
    },
    "git_executable_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$",
      "not": {
        "pattern": "(^[Aa][Uu][Tt][Oo]$|^[Dd][Ee][Ff][Aa][Uu][Ll][Tt]$|[Rr][Oo][Uu][Tt][Ee][Rr]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee]|[Pp][Rr][Oo][Dd][Uu][Cc][Tt][Ii][Oo][Nn]|\\*)"
      }
    },
    "expected_model_revision": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*@(?:[0-9][A-Za-z0-9._:+-]{3,}|[A-Za-z](?:[0-9][A-Za-z0-9._:+-]{2,}|[A-Za-z0-9._:+-][0-9][A-Za-z0-9._:+-]+|[A-Za-z0-9._:+-]{2,}[0-9][A-Za-z0-9._:+-]*))$",
      "minLength": 8,
      "not": {
        "pattern": "([Rr][Oo][Uu][Tt][Ee][Rr]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee]|[Pp][Rr][Oo][Dd][Uu][Cc][Tt][Ii][Oo][Nn])"
      }
    },
    "reasoning_effort": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "permission_profile": {
      "const": "workspace-write"
    },
    "developer_instructions": {
      "type": "string",
      "maxLength": 65536
    },
    "source_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_revision": {
      "$ref": "#/$defs/git_object_id"
    },
    "source_base_revision": {
      "$ref": "#/$defs/git_object_id"
    },
    "source_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "code_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_catalog_sha256",
        "task_id",
        "toolchain_sha256"
      ],
      "properties": {
        "task_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_id": {
          "type": "string",
          "pattern": "^(cpp\\.(fmt|seastar)|go\\.(chi|go-git)|rust\\.(clap|scylla-driver)|java\\.(commons-lang|scylla-driver)|python\\.(click|scylla-ccm)|typescript\\.(got|kysely))\\.code\\.(small|medium|large|huge)$"
        },
        "toolchain_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "timeout_millis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200000
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  },
  "$defs": {
    "git_object_id": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
