{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scopesifter/scopesifter/benchmarks/tokenbench/study/schemas/objective-code-quality-v1.schema.json",
  "title": "Tokenbench authenticated objective code quality boundary v1",
  "$comment": "No production constructor or code runner exists in this milestone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_sha256", "task_id", "task_family", "repetition", "baseline_outcome_sha256", "candidate_outcome_sha256", "baseline_score_ppm", "candidate_score_ppm", "baseline_pass", "candidate_pass"],
  "properties": {
    "schema_version": {"const": "tokenbench.objective-code-quality/v1"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "task_id": {"$ref": "#/$defs/id"},
    "task_family": {"const": "code"},
    "repetition": {"type": "integer", "minimum": 0, "maximum": 999},
    "baseline_outcome_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_outcome_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_score_ppm": {"$ref": "#/$defs/ppm"},
    "candidate_score_ppm": {"$ref": "#/$defs/ppm"},
    "baseline_pass": {"type": "boolean"},
    "candidate_pass": {"type": "boolean"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ppm": {"type": "integer", "minimum": 0, "maximum": 1000000}
  }
}
