{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yapless/scopesifter/benchmarks/tokenbench/study/schemas/verified-quality-v3.schema.json",
  "title": "Tokenbench two-judge verified quality v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_sha256", "task_id", "task_family", "repetition", "packet_commitment", "aggregation", "judgments", "baseline_score_ppm", "candidate_score_ppm", "baseline_pass", "candidate_pass"],
  "properties": {
    "schema_version": {"const": "tokenbench.verified-quality/v3"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "task_id": {"$ref": "#/$defs/id"},
    "task_family": {"enum": ["review", "explain"]},
    "repetition": {"type": "integer", "minimum": 0, "maximum": 999},
    "packet_commitment": {"$ref": "#/$defs/sha256"},
    "aggregation": {"const": "arithmetic_mean"},
    "judgments": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/judgment"}},
    "baseline_score_ppm": {"$ref": "#/$defs/ppm"},
    "candidate_score_ppm": {"$ref": "#/$defs/ppm"},
    "baseline_pass": {"type": "boolean"},
    "candidate_pass": {"type": "boolean"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "output_sha256", "output", "items", "baseline_score_ppm", "candidate_score_ppm", "baseline_pass", "candidate_pass"],
      "properties": {
        "evaluator_id": {"$ref": "#/$defs/id"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "output": {"$ref": "#/$defs/evaluatorOutput"},
        "items": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/item"}},
        "baseline_score_ppm": {"$ref": "#/$defs/ppm"},
        "candidate_score_ppm": {"$ref": "#/$defs/ppm"},
        "baseline_pass": {"type": "boolean"},
        "candidate_pass": {"type": "boolean"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "baseline_score", "candidate_score"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "baseline_score": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "candidate_score": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "evaluatorOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "evaluator_id", "nonce", "commitment", "answers"],
      "properties": {
        "schema_version": {"const": "tokenbench.evaluator-output/v3"},
        "evaluator_id": {"$ref": "#/$defs/id"},
        "nonce": {"$ref": "#/$defs/sha256"},
        "commitment": {"$ref": "#/$defs/sha256"},
        "answers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/evaluatorAnswer"}}
      }
    },
    "evaluatorAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "items"],
      "properties": {
        "label": {"enum": ["answer_1", "answer_2"]},
        "items": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/evaluatorItem"}}
      }
    },
    "evaluatorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "score", "rationale"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "score": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 16000}
      }
    }
  }
}
