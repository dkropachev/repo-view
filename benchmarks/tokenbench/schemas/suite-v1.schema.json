{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkropachev/repo-view/benchmarks/tokenbench/schemas/suite-v1.schema.json",
  "title": "Tokenbench authored suite v1",
  "description": "One common task and harness configuration. Arms and tool registrations are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "prompt_file",
    "harness_kind",
    "harness_executable",
    "harness_sha256",
    "git_executable",
    "git_executable_sha256",
    "model",
    "expected_model_revision",
    "reasoning_effort",
    "permission_profile",
    "developer_instructions",
    "source_root",
    "source_revision",
    "source_base_revision",
    "source_tree_sha256",
    "timeout_millis",
    "repetitions",
    "seed"
  ],
  "properties": {
    "schema_version": {
      "const": "tokenbench.suite/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "prompt_file": {
      "type": "string",
      "minLength": 1
    },
    "harness_kind": {
      "type": "string",
      "minLength": 1
    },
    "harness_executable": {
      "type": "string",
      "pattern": "^/"
    },
    "harness_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "git_executable": {
      "type": "string",
      "pattern": "^/"
    },
    "git_executable_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$",
      "not": {
        "pattern": "(^[Aa][Uu][Tt][Oo]$|^[Dd][Ee][Ff][Aa][Uu][Ll][Tt]$|[Rr][Oo][Uu][Tt][Ee][Rr]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee]|[Pp][Rr][Oo][Dd][Uu][Cc][Tt][Ii][Oo][Nn]|\\*)"
      }
    },
    "expected_model_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*@(?:[0-9][A-Za-z0-9._:+-]{3,}|[A-Za-z](?:[0-9][A-Za-z0-9._:+-]{2,}|[A-Za-z0-9._:+-][0-9][A-Za-z0-9._:+-]+|[A-Za-z0-9._:+-]{2,}[0-9][A-Za-z0-9._:+-]*))$",
      "minLength": 8,
      "not": {
        "pattern": "([Rr][Oo][Uu][Tt][Ee][Rr]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee]|[Pp][Rr][Oo][Dd][Uu][Cc][Tt][Ii][Oo][Nn])"
      }
    },
    "reasoning_effort": {
      "type": "string",
      "minLength": 1
    },
    "permission_profile": {
      "const": "read-only"
    },
    "developer_instructions": {
      "type": "string"
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "$ref": "#/$defs/git_object_id"
    },
    "source_base_revision": {
      "$ref": "#/$defs/git_object_id"
    },
    "source_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "timeout_millis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  },
  "$defs": {
    "git_object_id": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
