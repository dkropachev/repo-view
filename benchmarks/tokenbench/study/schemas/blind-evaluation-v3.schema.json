{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scopesifter/scopesifter/benchmarks/tokenbench/study/schemas/blind-evaluation-v3.schema.json",
  "title": "Tokenbench blind evaluation packet v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_sha256", "nonce", "commitment", "task_id", "criteria", "answers"],
  "properties": {
    "schema_version": {"const": "tokenbench.blind-evaluation/v3"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "nonce": {"$ref": "#/$defs/sha256"},
    "commitment": {"$ref": "#/$defs/sha256"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "criteria": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/criterion"}},
    "answers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/answer1"},
        {"$ref": "#/$defs/answer2"}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "kind", "requirement", "expected", "maximum_points"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "kind": {"enum": ["fact", "rubric"]},
        "requirement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "expected": {"type": "string", "minLength": 1, "maxLength": 8000},
        "maximum_points": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "answer1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "properties": {"label": {"const": "answer_1"}, "text": {"type": "string", "minLength": 1, "maxLength": 16777216}}
    },
    "answer2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "properties": {"label": {"const": "answer_2"}, "text": {"type": "string", "minLength": 1, "maxLength": 16777216}}
    }
  }
}
