{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkropachev/repo-view/benchmarks/tokenbench/study/schemas/study-policy-v1.schema.json",
  "title": "Tokenbench study policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "tasks", "exclusion_reasons", "quality", "analysis", "seeds"],
  "properties": {
    "schema_version": {"const": "tokenbench.study-policy/v1"},
    "study_id": {"$ref": "#/$defs/id"},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/task"}},
    "exclusion_reasons": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/exclusionReason"}},
    "quality": {"$ref": "#/$defs/quality"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "seeds": {"$ref": "#/$defs/seeds"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "requirement", "expected", "maximum_points"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "requirement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "expected": {"type": "string", "minLength": 1, "maxLength": 8000},
        "maximum_points": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "requirement", "maximum_points"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "requirement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "maximum_points": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "suite_sha256", "prompt_sha256", "repository_cluster_id", "task_family", "status", "exclusion_reason", "repetitions", "facts", "rubric"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "suite_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "repository_cluster_id": {"$ref": "#/$defs/id"},
        "task_family": {"$ref": "#/$defs/id"},
        "status": {"enum": ["included", "excluded"]},
        "exclusion_reason": {"type": "string", "maxLength": 2000},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 1000},
        "facts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/fact"}},
        "rubric": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/rubric"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "included"}}}, "then": {"properties": {"exclusion_reason": {"const": ""}}}},
        {"if": {"properties": {"status": {"const": "excluded"}}}, "then": {"properties": {"exclusion_reason": {"minLength": 1}}}}
      ]
    },
    "exclusionReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_answer_score_ppm", "minimum_candidate_pass_rate_ppm", "noninferiority_margin_ppm"],
      "properties": {
        "minimum_answer_score_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "minimum_candidate_pass_rate_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "noninferiority_margin_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Go validation additionally requires confidence_level_ppm to equal 1000000 minus alpha_ppm.",
      "required": ["minimum_complete_pairs", "minimum_complete_tasks", "maximum_failed_pairs", "maximum_excluded_pairs", "maximum_not_attempted_pairs", "maximum_missing_answer_pairs", "maximum_quality_missing_pairs", "minimum_token_reduction_ppm", "alpha_ppm", "confidence_level_ppm", "exact_randomization_max_clusters", "monte_carlo_samples", "bootstrap_samples"],
      "properties": {
        "minimum_complete_pairs": {"type": "integer", "minimum": 2, "maximum": 100000},
        "minimum_complete_tasks": {"type": "integer", "minimum": 2, "maximum": 10000},
        "maximum_failed_pairs": {"type": "integer", "minimum": 0, "maximum": 100000},
        "maximum_excluded_pairs": {"type": "integer", "minimum": 0, "maximum": 100000},
        "maximum_not_attempted_pairs": {"type": "integer", "minimum": 0, "maximum": 100000},
        "maximum_missing_answer_pairs": {"type": "integer", "minimum": 0, "maximum": 100000},
        "maximum_quality_missing_pairs": {"type": "integer", "minimum": 0, "maximum": 100000},
        "minimum_token_reduction_ppm": {"type": "integer", "minimum": 0, "maximum": 999999},
        "alpha_ppm": {"type": "integer", "minimum": 1, "maximum": 499999},
        "confidence_level_ppm": {"type": "integer", "minimum": 500001, "maximum": 999999},
        "exact_randomization_max_clusters": {"type": "integer", "minimum": 1, "maximum": 20},
        "monte_carlo_samples": {"type": "integer", "minimum": 1000, "maximum": 1000000},
        "bootstrap_samples": {"type": "integer", "minimum": 1000, "maximum": 1000000}
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blinding_sha256", "randomization_sha256", "bootstrap_sha256"],
      "properties": {
        "blinding_sha256": {"$ref": "#/$defs/sha256"},
        "randomization_sha256": {"$ref": "#/$defs/sha256"},
        "bootstrap_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
