{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yapless/scopesifter/benchmarks/tokenbench/study/schemas/evaluator-output-v3.schema.json",
  "title": "Tokenbench evaluator output v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluator_id", "nonce", "commitment", "answers"],
  "properties": {
    "schema_version": {"const": "tokenbench.evaluator-output/v3"},
    "evaluator_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "nonce": {"$ref": "#/$defs/sha256"},
    "commitment": {"$ref": "#/$defs/sha256"},
    "answers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/answer"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "items"],
      "properties": {
        "label": {"enum": ["answer_1", "answer_2"]},
        "items": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "score", "rationale"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "score": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 16000}
      }
    }
  }
}
